---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-3 my-10">
      <div class="animate flex items-center gap-1.5 text-muted">
        <div class="font-base text-xs font-medium uppercase tracking-widest">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-xs font-medium uppercase tracking-widest">
          {readingTime(post.body ?? "")}
        </div>
      </div>
      <div class="animate font-display text-4xl leading-tight text-ink sm:text-5xl">
        {post.data.title}
      </div>
    </div>
    <article class="animate markdown-content">
      <Content />
    </article>
  </Container>
</PageLayout>
