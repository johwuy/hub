---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import { SITE } from "@consts";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const blog = await getCollection("blog", ({ data }) => !data.draft);
const hasProjects = projects.length > 0;
const hasBlog = blog.length > 0;
const currentPath = Astro.url.pathname;
const blogIsActive = currentPath === "/" || currentPath.startsWith("/blog");
const workIsActive = currentPath.startsWith("/work");
const projectsIsActive = currentPath.startsWith("/projects");
---

<header class="site-header">
  <Container>
    <div class="flex flex-wrap gap-y-2 items-center justify-between rounded-xl border border-line/80 bg-panel/90 px-4 py-3 shadow-sm backdrop-blur-md">
      <div class="flex items-center gap-2">
        <Link href="/" underline={false} class="font-display text-2xl leading-none text-ink">
          {SITE.NAME}
        </Link>
        <span aria-hidden="true" class="text-muted">·</span>
        <a href="https://www.linkedin.com/in/johwuy/" target="_blank" rel="noopener noreferrer" aria-label="Johnny Wu on LinkedIn" title="LinkedIn" class="text-muted transition-colors hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z" />
          </svg>
        </a>
      </div>
      <nav class="flex items-center gap-1 text-sm">
        {hasBlog && (
          <Link href="/" underline={false} class={`rounded-md px-2.5 py-1.5 ${blogIsActive ? "bg-raised text-ink" : "hover:bg-raised/70"}`}>
            blog
          </Link>
        )}
        <Link href="/work" underline={false} class={`rounded-md px-2.5 py-1.5 ${workIsActive ? "bg-raised text-ink" : "hover:bg-raised/70"}`}>
          work
        </Link>
        {hasProjects && (
          <Link href="/projects" underline={false} class={`rounded-md px-2.5 py-1.5 ${projectsIsActive ? "bg-raised text-ink" : "hover:bg-raised/70"}`}>
            projects
          </Link>
        )}
      </nav>
    </div>
  </Container>
</header>
