---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
}

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={cn("inline-block text-current transition-colors duration-200 ease-out hover:text-ink", underline && "underline underline-offset-4 decoration-line hover:decoration-accent", className)}
  {...rest}>
  <slot/>
</a>
