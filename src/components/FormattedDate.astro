---
interface Props {
  date: Date;
  showDate?: boolean;
}

const { date, showDate = false } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-us", {
      month: "short",
      ...(showDate && { day: "numeric" }),
      year: "numeric",
    })
  }
</time>
