---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex flex-wrap justify-between items-center gap-3 border-t border-line pt-5">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted">
        <span>&copy; {new Date().getFullYear()} {`|`} {SITE.NAME}</span>
      </div>
      <div role="group" aria-label="Color theme" class="flex items-center gap-0.5 rounded-full border border-line p-1 text-xs">
        <button
          id="light-theme-button"
          aria-label="Light theme"
          type="button"
          aria-pressed="false"
          class="group flex items-center justify-center gap-1.5 rounded-full px-2.5 py-1.5 transition-colors hover:text-ink aria-pressed:bg-raised aria-pressed:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-ink transition-colors duration-200 ease-out"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span>Light</span>
        </button>
        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          type="button"
          aria-pressed="false"
          class="group flex items-center justify-center gap-1.5 rounded-full px-2.5 py-1.5 transition-colors hover:text-ink aria-pressed:bg-raised aria-pressed:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-ink transition-colors duration-200 ease-out"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>Dark</span>
        </button>
        <button
          id="system-theme-button"
          aria-label="System theme"
          type="button"
          aria-pressed="false"
          class="group flex items-center justify-center gap-1.5 rounded-full px-2.5 py-1.5 transition-colors hover:text-ink aria-pressed:bg-raised aria-pressed:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-ink transition-colors duration-200 ease-out"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>System</span>
        </button>
      </div>
    </div>
  </Container>
</footer>
