---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
---

<a href={`/${entry.collection}/${entry.id}`} class="group block py-5 text-current">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="font-display text-2xl leading-tight text-ink transition-colors duration-200 group-hover:text-accent">
      {entry.data.title}
      </div>
      <div class="mt-1 text-base leading-relaxed text-muted">
        {entry.data.description}
      </div>
    </div>
    <span aria-hidden="true" class="mt-1 text-lg leading-none text-muted transition-all duration-200 group-hover:translate-x-1 group-hover:text-accent">
      &rarr;
    </span>
  </div>
</a>
